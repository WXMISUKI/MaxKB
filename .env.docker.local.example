# Copy to .env.docker.local and fill real values. Do not commit .env.docker.local.

PREFLIGHT_API_KEY=replace-with-worker-bearer-key
PADDLEOCR_TOKEN=replace-with-paddleocr-token
PADDLEOCR_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_MODEL=PaddleOCR-VL-1.6

MAXKB_USERNAME=admin
MAXKB_PASSWORD=replace-with-maxkb-admin-password
MAXKB_WORKSPACE_ID=default
MAXKB_DEFAULT_KNOWLEDGE_ID=
MAXKB_KNOWLEDGE_NAME=南江至东岭高速公路改扩建工程 JD-A1 监理审查知识库
